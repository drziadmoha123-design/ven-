# Infrastructure Settings
NODE_ENV="development"
APP_URL="http://localhost:3000"

# Database Configuration
SQL_HOST="localhost"
SQL_DB_NAME="venplus"
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="password"
DATABASE_URL="postgres://postgres:password@localhost:5432/venplus"

# Security
AUTH_SECRET="development-secret-key-do-not-use-in-production"
CRON_SECRET="development-cron-secret-key"

# Admin Bootstrap Identity (Required)
ADMIN_EMAIL="admin@venplus.com"
ADMIN_PASSWORD_HASH="hash-representation"

# Storage
STORAGE_PROVIDER="local"
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Email
EMAIL_FROM="noreply@venplus.com"
EMAIL_PROVIDER_API_KEY=""

# Google Auth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"
